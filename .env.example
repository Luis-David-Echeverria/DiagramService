# Plantilla de ./.env para docker compose. SOLO NOMBRES: los valores se ponen
# en el servidor, en ./.env (chmod 600), que nunca entra en el repositorio.
# Ver docs/DEPLOY-HETZNER.md.

# Etiqueta de la imagen que se construye/arranca (p. ej. el sha corto del commit).
DIAGRAMSERVICE_TAG=

# Claves de X-API-Key. Las exigen Caddy (en el borde) y el servicio (detras):
# compose arma DIAGRAMSERVICE_API_KEYS del servicio con las dos.
# Cada una: 'openssl rand -hex 32' (64 caracteres hex; nada de espacios, comas
# ni '*'). Las DOS son obligatorias: fuera de una rotacion, PREVIOUS = la misma
# que API_KEY; durante la rotacion, API_KEY = la nueva y PREVIOUS = la vieja.
DIAGRAMSERVICE_API_KEY=
DIAGRAMSERVICE_API_KEY_PREVIOUS=

# Tamano maximo del cuerpo en bytes (opcional; por defecto 8 MiB).
MAX_BODY_BYTES=

# Nombre DNS publico del servicio (registro A/AAAA hacia el servidor).
DIAGRAMSERVICE_DOMAIN=

# Correo de contacto para Let's Encrypt (certificado por HTTP-01 en el 80).
ACME_EMAIL=

# IP o CIDR (separadas por espacio) que pueden llamar: la IP publica de salida
# de VMBimcon02 (FLU3NCE). La misma que deja pasar el firewall de Hetzner al 443.
DIAGRAMSERVICE_ALLOWED_IPS=
